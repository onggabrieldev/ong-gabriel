# Read by compose.yaml. On the VPS this file is /opt/ong-gabriel/.env.

# Apex domain served by Caddy. www redirects to it.
SITE_DOMAIN=
# Let's Encrypt sends certificate notices here.
ACME_EMAIL=
# Image tag. deploy/release.sh sets it on every release.
WEB_TAG=

# Django environment: local, dev, or prod.
ENVIRONMENT=
# Django debug. May be true only when ENVIRONMENT=local.
DEBUG=
# Django secret key. Required. No default in code.
SECRET_KEY=
# Postgres URL, for example postgresql://ong_gabriel:ong_gabriel@127.0.0.1:5432/ong_gabriel
DATABASE_URL=
# Comma-separated hostnames allowed to serve the API.
ALLOWED_HOSTS=
# Comma-separated origins trusted for CSRF, including the scheme.
CSRF_TRUSTED_ORIGINS=
