# Read by compose.yaml. On the VPS this file is /opt/ong-gabriel/.env.

# Apex domain served by Caddy. www redirects to it.
SITE_DOMAIN=
# Let's Encrypt sends certificate notices here.
ACME_EMAIL=
# Image tag. deploy/release.sh sets it on every release.
WEB_TAG=
# API image tag. deploy/release.sh sets it on every release.
API_TAG=

# Django environment: local, dev, or prod.
ENVIRONMENT=
# Django debug. May be true only when ENVIRONMENT=local.
DEBUG=
# Django secret key. Required. No default in code.
SECRET_KEY=
# Postgres URL, for example postgresql://ong_gabriel:ong_gabriel@127.0.0.1:5432/ong_gabriel
# On the VPS the host is the compose service name `db`.
DATABASE_URL=
# Postgres role, password, and database for the compose `db` service.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Comma-separated hostnames allowed to serve the API. Include the public host, api, and 127.0.0.1.
ALLOWED_HOSTS=
# Comma-separated origins trusted for CSRF, including the scheme.
CSRF_TRUSTED_ORIGINS=
# Next.js origin used in verification and reset emails. No trailing slash.
FRONTEND_URL=
# When false, every signup is closed, Google included. Login still works for existing accounts.
SIGNUP_ENABLED=
# When false, email and password signup is closed. Only applies when SIGNUP_ENABLED is true.
PASSWORD_SIGNUP_ENABLED=
# Media files directory. Leave empty locally; the compose file sets it in the container.
MEDIA_ROOT=
# Trusted reverse proxies in X-Forwarded-For. Must be at least 1 outside local (Caddy).
TRUSTED_PROXY_COUNT=
# SMTP host. Local default is Mailpit on 127.0.0.1.
EMAIL_HOST=
# SMTP port. Local default is 1025.
EMAIL_PORT=
# SMTP username. Empty for Mailpit.
EMAIL_HOST_USER=
# SMTP password. Empty for Mailpit.
EMAIL_HOST_PASSWORD=
# Use STARTTLS for SMTP. False for Mailpit.
EMAIL_USE_TLS=
# From address for account emails.
DEFAULT_FROM_EMAIL=
# Google OAuth client ID. Empty disables the Google provider.
GOOGLE_CLIENT_ID=
# Google OAuth client secret. Empty disables the Google provider.
GOOGLE_CLIENT_SECRET=
